rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── who's who ──
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in ['jpboyls@gmail.com', 'jordanb@sparetimesportsclubs.com']; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/players/$(email())); }
    function canRead()  { return isMember() || isAdmin(); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── players: id = lowercase email ──
    match /players/{pid} {
      allow read:   if canRead();
      allow create, delete: if isAdmin();
      // admin edits anything; a member may edit only their own contact fields and contact-privacy switches
      allow update: if isAdmin()
                    || (isMember() && pid == email() && onlyKeys(['phone', 'availability', 'hidePhone', 'hideEmail']));
    }

    // ── matches: anyone who played in it can record it; only admin edits/removes ──
    match /matches/{mid} {
      allow read: if canRead();
      allow create: if isAdmin()
                    || (isMember()
                        && request.resource.data.submittedBy == email()
                        && email() in [request.resource.data.p1, request.resource.data.p2,
                                       request.resource.data.p1Partner, request.resource.data.p2Partner]
                        && request.resource.data.winner in [request.resource.data.p1, request.resource.data.p2]
                        && request.resource.data.ladder in ['ms', 'ws', 'md', 'wd', 'mx']
                        && request.resource.data.score is string && request.resource.data.score.size() <= 40
                        && request.resource.data.status == 'pending');
      // the other side may confirm or dispute a pending score, once
      allow update: if isAdmin()
                    || (isMember() && resource.data.status == 'pending'
                        && email() != resource.data.submittedBy
                        && ((resource.data.submittedBy in [resource.data.p1, resource.data.p1Partner] && email() in [resource.data.p2, resource.data.p2Partner])
                            || (resource.data.submittedBy in [resource.data.p2, resource.data.p2Partner] && email() in [resource.data.p1, resource.data.p1Partner]))
                        && request.resource.data.status in ['confirmed', 'disputed']
                        && onlyKeys(['status', 'confirmedBy', 'confirmedAt']));
      allow delete: if isAdmin();
    }

    // ── challenges ──
    match /challenges/{cid} {
      allow read: if canRead();
      allow create: if isMember() && request.resource.data.from == email() && request.resource.data.status == 'pending';
      // recipient or sender may change status (incl. 'rainout' = cancelled for rain, no penalty),
      // or reschedule once for rain: extends the play-by date by up to 15 days from now
      allow update: if isAdmin()
                    || (isMember() && (resource.data.to == email() || resource.data.from == email())
                        && (onlyKeys(['status', 'respondedAt', 'rainBy', 'rainAt'])
                            || (onlyKeys(['rainedOut', 'rainBy', 'rainAt', 'playBy', 'date'])
                                && resource.data.get('rainedOut', false) != true
                                && request.resource.data.rainedOut == true
                                && request.resource.data.rainBy == email()
                                && request.resource.data.playBy is int
                                && request.resource.data.playBy <= request.time.toMillis() + 15 * 86400000)));
      allow delete: if isAdmin() || (isMember() && resource.data.from == email());
    }

    // ── practice board ──
    match /hits/{hid} {
      allow read: if canRead();
      allow create: if isMember() && request.resource.data.by == email();
      // owner edits/closes their post; any member may toggle their own interest (responses array only)
      allow update: if isAdmin()
                    || (isMember() && resource.data.by == email())
                    || (isMember() && onlyKeys(['responses']));
      allow delete: if isAdmin() || (isMember() && resource.data.by == email());
    }

    // ── events: admin manages; members may only add/remove themselves from rsvps ──
    match /events/{eid} {
      allow read: if canRead();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isMember() && onlyKeys(['rsvps'])
                        && request.resource.data.rsvps.toSet().difference(resource.data.rsvps.toSet()).union(
                             resource.data.rsvps.toSet().difference(request.resource.data.rsvps.toSet())).hasOnly([email()]));
    }

    // ── sign-ups from the public form: anyone may submit, only admin may see ──
    match /signups/{sid} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.size() <= 20;
      allow read, update, delete: if isAdmin();
    }

    // ════════════════ JUNIOR LADDER (jr_ collections) ════════════════
    // Parents sign in. jr_families/{parent email}.kids lists the players they manage (kept up to date by the app).
    // Adult members can't read junior data, and junior parents can't read adult data.
    function jrAdmin()    { return isAdmin() || (signedIn() && email() in []); }   // add the Junior Coordinator here too
    function jrFamily()   { return /databases/$(database)/documents/jr_families/$(email()); }
    function isJrParent() { return signedIn() && exists(jrFamily()); }
    function myKids()     { return get(jrFamily()).data.kids; }
    function myKid(id)    { return isJrParent() && id in myKids(); }
    function jrRead()     { return isJrParent() || jrAdmin(); }

    match /jr_families/{fid} {
      allow read: if jrAdmin() || (signedIn() && fid == email());
      allow write: if jrAdmin();
    }
    match /jr_players/{pid} {
      allow read: if jrRead();
      allow create, delete: if jrAdmin();
      allow update: if jrAdmin() || (myKid(pid) && onlyKeys(['phone', 'availability', 'hidePhone', 'hideEmail']));
    }
    match /jr_matches/{mid} {
      allow read: if jrRead();
      allow create: if jrAdmin()
                    || (myKid(request.resource.data.submittedBy)
                        && request.resource.data.submittedBy in [request.resource.data.p1, request.resource.data.p2,
                                                                  request.resource.data.p1Partner, request.resource.data.p2Partner]
                        && request.resource.data.winner in [request.resource.data.p1, request.resource.data.p2]
                        && request.resource.data.ladder in ['o10', 'g12', 'b14', 'g14', 'b16', 'g16', 'b18', 'g18', 'jd']
                        && request.resource.data.score is string && request.resource.data.score.size() <= 40
                        && request.resource.data.status == 'pending');
      // a parent of a player on the other side may confirm or dispute a pending score, once
      allow update: if jrAdmin()
                    || (isJrParent() && resource.data.status == 'pending'
                        && myKid(request.resource.data.confirmedBy)
                        && ((resource.data.submittedBy in [resource.data.p1, resource.data.p1Partner]
                             && request.resource.data.confirmedBy in [resource.data.p2, resource.data.p2Partner])
                            || (resource.data.submittedBy in [resource.data.p2, resource.data.p2Partner]
                             && request.resource.data.confirmedBy in [resource.data.p1, resource.data.p1Partner]))
                        && request.resource.data.status in ['confirmed', 'disputed']
                        && onlyKeys(['status', 'confirmedBy', 'confirmedAt']));
      allow delete: if jrAdmin();
    }
    match /jr_challenges/{cid} {
      allow read: if jrRead();
      allow create: if myKid(request.resource.data.from) && request.resource.data.status == 'pending';
      allow update: if jrAdmin()
                    || ((myKid(resource.data.to) || myKid(resource.data.from))
                        && (onlyKeys(['status', 'respondedAt', 'rainBy', 'rainAt'])
                            || (onlyKeys(['rainedOut', 'rainBy', 'rainAt', 'playBy', 'date'])
                                && resource.data.get('rainedOut', false) != true
                                && request.resource.data.rainedOut == true
                                && myKid(request.resource.data.rainBy)
                                && request.resource.data.playBy is int
                                && request.resource.data.playBy <= request.time.toMillis() + 15 * 86400000)));
      allow delete: if jrAdmin() || myKid(resource.data.from);
    }
    match /jr_events/{eid} {
      allow read: if jrRead();
      allow create, delete: if jrAdmin();
      // a parent may only add or remove their own children from the sign-up list
      allow update: if jrAdmin()
                    || (isJrParent() && onlyKeys(['rsvps'])
                        && request.resource.data.rsvps.toSet().difference(resource.data.rsvps.toSet()).union(
                             resource.data.rsvps.toSet().difference(request.resource.data.rsvps.toSet())).hasOnly(myKids()));
    }
    match /jr_signups/{sid} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.size() <= 24;
      allow read, update, delete: if jrAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
