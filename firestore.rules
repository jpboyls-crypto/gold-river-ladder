rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── who's who ──
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in ['jpboyls@gmail.com', 'jordanb@sparetimesportsclubs.com']; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/players/$(email())); }
    function canRead()  { return isMember() || isAdmin(); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ── players: id = lowercase email ──
    match /players/{pid} {
      allow read:   if canRead();
      allow create, delete: if isAdmin();
      // admin edits anything; a member may edit only their own contact fields
      allow update: if isAdmin()
                    || (isMember() && pid == email() && onlyKeys(['phone', 'availability']));
    }

    // ── matches: anyone who played in it can record it; only admin edits/removes ──
    match /matches/{mid} {
      allow read: if canRead();
      allow create: if isAdmin()
                    || (isMember()
                        && request.resource.data.submittedBy == email()
                        && email() in [request.resource.data.p1, request.resource.data.p2,
                                       request.resource.data.p1Partner, request.resource.data.p2Partner]
                        && request.resource.data.winner in [request.resource.data.p1, request.resource.data.p2]
                        && request.resource.data.ladder in ['ms', 'ws', 'md', 'wd', 'mx']
                        && request.resource.data.score is string && request.resource.data.score.size() <= 40
                        && request.resource.data.status == 'pending');
      // the other side may confirm or dispute a pending score, once
      allow update: if isAdmin()
                    || (isMember() && resource.data.status == 'pending'
                        && email() != resource.data.submittedBy
                        && ((resource.data.submittedBy in [resource.data.p1, resource.data.p1Partner] && email() in [resource.data.p2, resource.data.p2Partner])
                            || (resource.data.submittedBy in [resource.data.p2, resource.data.p2Partner] && email() in [resource.data.p1, resource.data.p1Partner]))
                        && request.resource.data.status in ['confirmed', 'disputed']
                        && onlyKeys(['status', 'confirmedBy', 'confirmedAt']));
      allow delete: if isAdmin();
    }

    // ── challenges ──
    match /challenges/{cid} {
      allow read: if canRead();
      allow create: if isMember() && request.resource.data.from == email() && request.resource.data.status == 'pending';
      // recipient or sender may change status; nothing else changes
      allow update: if isAdmin()
                    || (isMember() && (resource.data.to == email() || resource.data.from == email())
                        && onlyKeys(['status', 'respondedAt']));
      allow delete: if isAdmin() || (isMember() && resource.data.from == email());
    }

    // ── practice board ──
    match /hits/{hid} {
      allow read: if canRead();
      allow create: if isMember() && request.resource.data.by == email();
      // owner edits/closes their post; any member may toggle their own interest (responses array only)
      allow update: if isAdmin()
                    || (isMember() && resource.data.by == email())
                    || (isMember() && onlyKeys(['responses']));
      allow delete: if isAdmin() || (isMember() && resource.data.by == email());
    }

    // ── events: admin manages; members may only add/remove themselves from rsvps ──
    match /events/{eid} {
      allow read: if canRead();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isMember() && onlyKeys(['rsvps'])
                        && request.resource.data.rsvps.toSet().difference(resource.data.rsvps.toSet()).union(
                             resource.data.rsvps.toSet().difference(request.resource.data.rsvps.toSet())).hasOnly([email()]));
    }

    // ── sign-ups from the public form: anyone may submit, only admin may see ──
    match /signups/{sid} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.size() <= 20;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
